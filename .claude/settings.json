{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git tag *)",
      "Bash(git worktree *)",
      "Bash(./scripts/*)",
      "Bash(xvfb-run *)",
      "Bash(desktop-file-validate *)",
      "Bash(appstreamcli *)",
      "Bash(dpkg-deb *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(sudo *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)"
    ]
  }
}
